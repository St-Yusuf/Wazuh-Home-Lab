<!-- Add this group to local_rules.xml on the Wazuh manager.
     Keep existing rules, and ensure rule ID 100100 is not already in use. -->
<group name="local,syslog,sshd,">
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_sid>5760</if_sid>
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>Lab: Repeated SSH password failures from the same source IP within 120 seconds.</description>
    <group>authentication_failures,</group>
  </rule>
</group>
